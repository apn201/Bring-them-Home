{
  "name": "bring-them-home",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An Apollo 13 HTML5 cockpit game running original guidance-computer software.",
  "repository": {
    "type": "git",
    "url": "https://github.com/apn201/Bring-them-Home.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package:game": "tsc -b && node tools/package-game.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:verify": "node tools/verify-runtime-assets.mjs",
    "content:validate": "node tools/validate-content.mjs",
    "replay:verify": "node tools/verify-replay.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
